# train_and_export.py – Final Script voor Coral Edge TPU (MobileNetV2)
import os
import tensorflow as tf
import numpy as np

# -------------------------------
# 1. Configuratie
# -------------------------------
DATA_DIR = "dataset/nabirds/images"
IMG_SIZE = (300, 300)
BATCH_SIZE = 16  # Voor training
EPOCHS = 12
MODEL_DIR = "model"

os.makedirs(MODEL_DIR, exist_ok=True)

print(f"📂 Configuratie: {IMG_SIZE} input, {EPOCHS} epochs")

# -------------------------------
# 2. Dataset Laden & Bewerken
# -------------------------------
print("📂 Dataset laden (nabirds)...")

train_ds = tf.keras.utils.image_dataset_from_directory(
    DATA_DIR,
    validation_split=0.2,
    subset="training",
    seed=42,
    image_size=IMG_SIZE,
    batch_size=BATCH_SIZE,
    label_mode="categorical"
)

val_ds = tf.keras.utils.image_dataset_from_directory(
    DATA_DIR,
    validation_split=0.2,
    subset="validation",
    seed=42,
    image_size=IMG_SIZE,
    batch_size=BATCH_SIZE,
    label_mode="categorical"
)

# Verkrijg de klasnamen
class_names = train_ds.class_names
num_classes = len(class_names)
print(f"ℹ️ Aantal klassen: {num_classes} ({class_names})")

# Data Augmentatie en caching
AUTOTUNE = tf.data.AUTOTUNE

augment = tf.keras.Sequential([
    tf.keras.layers.RandomFlip("horizontal"),
    tf.keras.layers.RandomRotation(0.2),
    tf.keras.layers.RandomZoom(0.2),
], name="augmentation")

train_ds = (
    train_ds
    .map(lambda x, y: (augment(x, training=True), y), num_parallel_calls=AUTOTUNE)
    .cache()
    .shuffle(500)
    .prefetch(AUTOTUNE)
)

val_ds = val_ds.cache().prefetch(AUTOTUNE)

# -------------------------------
# 3. Model Bouwen (TPU-vriendelijk MobileNetV2)
# -------------------------------
print("\n⚙️ MobileNetV2 laden (TPU-compatibel)...")

base_model = tf.keras.applications.MobileNetV2(
    include_top=False,
    weights='imagenet',
    alpha=1.0,  # Breedte van het netwerk
    input_shape=(IMG_SIZE[0], IMG_SIZE[1], 3)
)
base_model.trainable = True

model = tf.keras.Sequential([
    tf.keras.layers.Input(shape=(IMG_SIZE[0], IMG_SIZE[1], 3)),
    base_model,
    tf.keras.layers.GlobalAveragePooling2D(),
    tf.keras.layers.Dropout(0.3),
    tf.keras.layers.Dense(num_classes, activation="softmax") # Dynamische klassen
])

model.compile(
    optimizer=tf.keras.optimizers.Adam(learning_rate=1e-4),
    loss="categorical_crossentropy",
    metrics=["accuracy"]
)

# -------------------------------
# 4. Trainen (GPU-afdwinging hier)
# -------------------------------
print("\n🚀 START TRAINING (probeer GPU:0 af te dwingen)...")

try:
    with tf.device("/GPU:0"):
        model.fit(
            train_ds,
            validation_data=val_ds,
            epochs=EPOCHS,
            verbose=1
        )
    print("\n✅ Training succesvol uitgevoerd op /GPU:0 (of de GPU is automatisch gebruikt).")
except RuntimeError as e:
    # Dit zal een fout veroorzaken als de GPU niet correct is geconfigureerd
    print(f"\n❌ FOUT: Kan /GPU:0 niet vinden of gebruiken. Controleer uw CUDA/cuDNN installatie of de Colab runtime-instellingen.")
    print(f"Details van de fout: {e}")
    # Optioneel: als u toch op de CPU wilt doorgaan, verwijder de 'raise' hieronder en de 'tf.device' hierboven.
    # Als u hier 'exit()' toevoegt, stopt het script als de GPU niet werkt.
    exit()

# -------------------------------
# 5. Conversie naar Edge TPU TFLite (Fixed Batch Size 1)
# -------------------------------
print("\n🔄 Converteren naar TFLite Edge TPU formaat...")

# CRUCIAAL: Dwing batch size 1 af voor de Edge TPU compiler.
try:
    model.input.set_shape((1, IMG_SIZE[0], IMG_SIZE[1], 3))
except:
    print("⚠️ Waarschuwing: Kon input shape niet direct forceren. Controleer handmatig.")


def representative_data_gen():
    data = train_ds.unbatch().batch(1).take(100)
    for input_value, _ in data:
        yield [tf.cast(input_value, tf.float32)]

# Setup Converter
converter = tf.lite.TFLiteConverter.from_keras_model(model)
converter.optimizations = [tf.lite.Optimize.DEFAULT]
converter.representative_dataset = representative_data_gen

converter.target_spec.supported_ops = [tf.lite.OpsSet.TFLITE_BUILTINS_INT8]
converter.inference_input_type = tf.uint8
converter.inference_output_type = tf.uint8

# Converteer!
tflite_model_content = converter.convert()

# Opslaan
tflite_filename = "nabirds_mobilenet_edgetpu.tflite"
tflite_path = os.path.join(MODEL_DIR, tflite_filename)

with open(tflite_path, "wb") as f:
    f.write(tflite_model_content)

# Sla labels op
label_path = os.path.join(MODEL_DIR, "labels.txt")
with open(label_path, "w") as f:
    f.write('\n'.join(class_names) + '\n')


print("\n" + "="*40)
print(f"✅ SUCCES! Bestand aangemaakt: {tflite_path}")
print("="*40)
print("👉 VOLGENDE STAPPEN:")
print(f"1. Upload '{tflite_filename}' naar Google Colab.")
print(f"2. Run in Colab: ! edgetpu_compiler -s {tflite_filename}")
print("3. Download het resultaat (*_edgetpu.tflite) en zet het op je Coral Board.")
print("4. Start de server met dit nieuwe, snelle model.")
print("="*40)
